{
  "name": "dql-to-sql",
  "displayName": "Doctrine to SQL Hover",
  "description": "Converte queries Doctrine ORM em SQL e mostra no hover e CodeLens",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "url": "https://github.com/horodeski/vscode-dql-to-sql-converter"
  },
  "homepage": "https://github.com/horodeski/vscode-dql-to-sql-converter",
  "bugs": {
    "url": "https://github.com/horodeski/vscode-dql-to-sql-converter/issues"
  },
  "publisher": "GeovanaSophiaHorodeski",
  "icon": "extension/image.png",
  "galleryBanner": {
    "color": "#030518",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.verSQL",
        "title": "Ver SQL do Doctrine QueryBuilder"
      }
    ],
    "languages": [
      {
        "id": "php",
        "extensions": [
          ".php"
        ],
        "aliases": [
          "PHP",
          "php"
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:php"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^14.17.0",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.60.0",
    "node-fetch": "^2.6.1",
    "tslint": "^6.1.3",
    "typescript": "^4.4.3"
  },
  "dependencies": {
    "node-fetch": "^2.6.1"
  }
}